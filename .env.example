# Copy to .env (never commit the real file).

PORT=3000

# Contact form: every submission is e-mailed to MAIL_TO.
MAIL_TO=info@imexinspection.com

# Mailbox the server logs in to and sends from. Using eren@ or info@ both work;
# replies go straight to the visitor (Reply-To is set to their address).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@imexinspection.com
SMTP_PASS=your-mailbox-password
MAIL_FROM="IMEX Inspection <info@imexinspection.com>"
